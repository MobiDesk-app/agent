# Only used by the headless mode (`npm run dev`). The desktop app keeps its
# settings in config.json in its user-data folder instead.

# Your backend server address.
SERVER_URL=http://localhost:8080

# Friendly name shown in your PC list (defaults to the computer name).
# DEVICE_NAME=Hazem-Desktop

# How often to re-scan the LAN and report devices, in milliseconds.
SCAN_INTERVAL_MS=30000

# Leave these empty the first time: the agent prints a 6-digit link code,
# and after you enter it in the app it prints the values to put here.
DEVICE_ID=
DEVICE_SECRET=
