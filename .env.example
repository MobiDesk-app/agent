# Copy to .env and fill in real values. Never commit .env.

# The backend's signaling WebSocket, e.g. ws://localhost:8080 for local dev
# or wss://your-domain.com for a deployed server.
BACKEND_URL=ws://localhost:8080

# Must match the backend's AUTH_TOKEN exactly.
AUTH_TOKEN=change-me-to-a-long-random-string

# A stable id for this PC. Pick something unique per machine.
DEVICE_ID=pc-1

# Friendly name shown in the phone app's device list.
DEVICE_NAME=Hazem-Desktop

# How often to re-scan the LAN and report devices, in milliseconds.
SCAN_INTERVAL_MS=30000
